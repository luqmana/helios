<?xml version="1.0"?>
<!DOCTYPE service_bundle SYSTEM "/usr/share/lib/xml/dtd/service_bundle.dtd.1">
<!--
    Copyright 2025 Oxide Computer Company
-->

<service_bundle type='manifest' name='oxide-dram-margining-report'>

<service name='oxide/dram-margining-report' type='service' version='1'>
    <create_default_instance enabled='true' />

    <!-- Wait for multi-user. -->
    <dependency name="multi_user"
                grouping="require_all"
                restart_on="none"
                type="service">
        <service_fmri value="svc:/milestone/multi-user:default" />
    </dependency>

    <!-- Also depend on the dmar-report binary -->
    <dependency
        name='dmar-report'
        grouping='require_all'
        restart_on='none'
        type='path'>
            <service_fmri
                value='file://localhost//usr/bin/dmar-report' />
    </dependency>

    <exec_method
        type='method'
        name='start'
        exec='/usr/lib/oxide/dmar-margining-report.sh'
        timeout_seconds='60' />

    <exec_method
        type='method'
        name='stop'
        exec=':kill'
        timeout_seconds='60' />

    <property_group name='startd' type='framework'>
        <propval name='duration' type='astring' value='transient' />
    </property_group>

    <stability value='Unstable' />

    <template>
        <common_name>
            <loctext xml:lang='C'>DRAM Margining Report</loctext>
        </common_name>
        <description>
            <loctext xml:lang='C'>
                Collects system and DRAM information for DRAM characterization.
            </loctext>
        </description>
    </template>
</service>

</service_bundle>
